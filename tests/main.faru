fn isZero(num :: int) bool {
    if num == 0: {
        return true;
    }

    return false;
}

fn isFalse(num :: bool) bool {
    if num: {
        return true;
    } else {
        return false;
    }
}

fn classify(num :: int) bool {
    if num == 0: {
        return true;
    } else if num == 1: {
        return false;
    } else if num == 2: {
        return true;
    } else {
        return false;
    }
}

fn nestedCheck(num :: int) bool {
    if num > 0: {
        if num == 1: {
            return true;
        }
    } else if num == 0: {
        return false;
    }

    return true;
}

fn bodyBeforeReturn(num :: int) bool {
    if num == 0: {
        return true;
    } else if num == 1: {
        return false;
    }

    num = num + 1;

    return num > 2;
}

fn noElseMerge(num :: int) bool {
    if num == 0: {
        num = 10;
    }

    num = num + 1;

    return num == 11;
}

fn elseMerge(num :: int) bool {
    if num == 0: {
        num = 10;
    } else {
        num = 20;
    }

    num = num + 1;

    return num > 10;
}
