x :: int = 10;
y :: int = 20;
flag :: bool = true;

fn add() int {
  a :: int = 10;
  b :: int = 20;
  result :: int = a + b;
  return result;
}

fn calculate() int {
  a :: int = 10;
  b :: int = 20;
  c :: int = a + b;
  d :: int = c * 2;
  e :: int = d - 10;

  if e > 100: {
    return e;
  } else if e > 50: {
    return e + 10;
  } else {
    return e - 10;
  }
}

fn arithmetic() int {
  a :: int = 100;
  b :: int = 25;

  a = a + b;
  b = a - b;
  a = a * b;
  b = a / 5;

  return a + b;
}

fn unary_test() int {
  a :: int = 10;
  b :: int = -a;

  if a > 0: {
    return -b;
  } else {
    return b;
  }
}

fn logic_test() int {
  a :: bool = true;
  b :: bool = false;

  if a and b: {
    return 1;
  } else if a or b: {
    return 2;
  } else {
    return 3;
  }
}

fn nested() int {
  x :: int = 75;

  if x > 0: {
    if x > 100: {
      return 3;
    } else if x > 50: {
      if x > 70: {
        return 2;
      } else {
        return 1;
      }
    } else {
      return 0;
    }
  } else {
    return -1;
  }
}

fn variables() int {
  a :: int = 1;
  b :: int = 2;
  c :: int = 3;
  d :: int = 4;
  e :: int = 5;

  a = a + b;
  b = b + c;
  c = c + d;
  d = d + e;
  e = e + a;

  return a + b + c + d + e;
}

fn main() int {
  a :: int = add();
  b :: int = calculate();
  c :: int = arithmetic();
  d :: int = unary_test();
  e :: int = logic_test();
  f :: int = nested();
  g :: int = variables();

  if a > 0 and b > 0: {
    if c > 0 and d > 0: {
      return e + f + g;
    } else if c == 0 or d == 0: {
      return a + b;
    } else {
      return c + d;
    }
  } else if a < 0 or b < 0: {
    return -1;
  } else {
    return 0;
  }
}
