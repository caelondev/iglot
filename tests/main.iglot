struct Node: {
    value :: int,
    next :: ?Node,
}

fn main() void: {
  head :: Node = {
    .value = 10,
    .next = {
      .value = 0,
      .next = null,
    },
  };

  println#({ head.next.?.next });
  head.next.? = { .value = 100, .next = null }; -- should error
  head.next.?.next = { .value = 100, .next = null };
  println#({ head.next.?.next });
  
}
