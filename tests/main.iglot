struct Address: {
  country :: string,
  province :: string,
  street :: ?string,
}

struct Details: {
    address :: Address,
}

struct User: {
    name :: string,
    details :: Details,
}

fn main() void {
  head :: User = {
    name = "bob",
    details = {
      address = {
        country = "Philippines",
        province = "Manila",
        street = null,
      },
    },
  };

  println({ head.details.address });
}
