fn fibonacci(n :: int) int {
  if n <= 1: {
    return n;
  }

  return fibonacci(n - 1) + fibonacci(n - 2);
}

fn is_even(n :: int) int {
  if n / 2 * 2 == n: {
    return 1;
  }

  return 0;
}

fn analyze(limit :: int) int {
  i :: int = 0;
  score :: int = 0;
  even_count :: int = 0;
  odd_count :: int = 0;

  loop {
    if i >= limit: {
      break;
    }

    value :: int = fibonacci(i);

    if value > 0: {
      if is_even(value) == 1: {
        even_count = even_count + 1;
        score = score + value;
      } else {
        odd_count = odd_count + 1;
        score = score + value / 2;
      }
    }

    i = i + 1;
  }

  if even_count > odd_count: {
    score = score + even_count * 3;
  } else {
    score = score + odd_count * 2;
  }

  return score;
}

fn main() int {
  limit :: int = 8;

  result :: int = analyze(limit);

  if result >= 50: {
    result = result + 10;
  } else {
    result = result - 5;
  }

  return result;
}
