module invert_binary_tree;

struct Node: {
  value :: int,
  left :: ?Node,
  right :: ?Node,
}

fn main() void: {
  root :: Node = {
    .value = 4,
    .left = {
      .value = 2,
      .left = {
        .value = 1,
        .left = null,
        .right = null,
      },
      .right = {
        .value = 3,
        .left = null,
        .right = null,
      },
    },
    .right = {
      .value = 7,
      .left = {
        .value = 6,
        .left = null,
        .right = null,
      },
      .right = {
        .value = 9,
        .left = null,
        .right = null,
      },
    },
  };

  println#({ "tree:" });
  tree_printer(root, 1, false);
  println#({ "inverted:" });
  inverted ::= invert_tree(root);
  if inverted == null: return;
  tree_printer(inverted.?, 1, false);
}

fn invert_tree(root :: ?Node) ?Node: {
  if root == null: return null;
  
  temp ::= root.?.left;
  root.?.left = root.?.right;
  root.?.right = temp;

  invert_tree(root.?.left);
  invert_tree(root.?.right);

  return root;
}

fn tree_printer(tree :: Node, depth :: int, bar :: bool) void: {
  if depth == 1:
    repeat_print(" ", depth);
  println#({ tree.value });
  if tree.left != null: {
    indent(depth, bar);
    print#({ "|- " });
    tree_printer(tree.left.?, depth + 3, tree.right != null);
  }
  if tree.right != null: {
    indent(depth, bar);
    print#({ "|- " });
    tree_printer(tree.right.?, depth + 3, false);
  }
}

fn indent(depth :: int, bar :: bool) void: {
  if depth == 1: {
    print#({ " " });
    return;
  }
  print#({ " " });
  if bar:
    print#({ "|" });
  else:
    print#({ " " });
  repeat_print(" ", depth - 2);
}

fn repeat_print(char :: string, n :: int) void: {
  i ::= 0;
  loop: {
    if i == n: return;
    print#({ char });
    i = i+1;
  }
}
